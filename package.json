{
  "name": "obsidian-records",
  "version": "0.1.0",
  "private": true,
  "description": "Show records kept in JSON or YAML data files as table, card and map views inside Obsidian Bases",
  "keywords": [
    "bases",
    "json",
    "obsidian",
    "obsidian-plugin",
    "records",
    "yaml"
  ],
  "license": "MIT",
  "author": {
    "name": "Jason Kuhrt",
    "url": "https://kuhrt.me"
  },
  "type": "module",
  "scripts": {
    "obsidian-dev": "bun scripts/obsidian-dev.ts",
    "build": "bun build.ts",
    "test": "bun test tests/",
    "check:types": "tsgo --noEmit",
    "check:lint": "oxlint --type-aware --deny-warnings",
    "check:format": "oxfmt --check",
    "fix:format": "oxfmt --write",
    "fix:lint": "oxlint --type-aware --fix-dangerously --deny-warnings",
    "fix": "bun run fix:format && bun run fix:lint",
    "check": "bun run check:format && bun run check:lint && bun run check:types && bun run test && bun run build"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.4",
    "@types/leaflet": "^1.9.22",
    "@types/supercluster": "^7.1.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "lint-staged": "^17.6.0",
    "obsidian": "1.14.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "yaml": "^2.9.1"
  }
}
